.desktop-release-artifacts/linux-*/*.rpm filter=lfs diff=lfs merge=lfs -text
.desktop-release-artifacts/windows/*.exe filter=lfs diff=lfs merge=lfs -text
.desktop-release-artifacts/windows/*.zip filter=lfs diff=lfs merge=lfs -text
