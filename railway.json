{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun run --cwd packages/server build:types && bun run --cwd packages/client build",
    "watchPatterns": ["packages/client/**", "packages/shared/**", "package.json", "bun.lockb"]
  },
  "deploy": {
    "startCommand": "bun run start:client",
    "healthcheckPath": "/",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
