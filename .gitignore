.agentiflow/

# Generated desktop packaging scratch space
.tmp/
.tmp-*/

# Audit / hardening scratch output (gate logs, one-off probe scripts).
# Excluded from biome + eslint too; see biome.json files.includes and
# eslint.config.mjs ignoredPaths.
.audit/
.hardening/
docs/assets/docs.generated.css

# Docs site release manifest (generated from packages/desktop/releases into the
# served path the docs site fetches: docs/releases/manifest.json).
# Local docs-site preview staging (mirrors deployed /releases for local testing)
docs/releases/

# Canonical release artifact sizes (committed SSOT). CI checkouts get Git LFS
# pointers (no `git lfs pull`), so the docs-site manifest builder reads sizes
# from this file when the on-disk artifact is a pointer. Real binaries on disk
# (after `git lfs pull`) still win as the SSOT — see fileSize() in
# scripts/build-docs-site-releases.ts. Keep this in sync after every release.
# packages/desktop/releases/sizes.json  (intentionally tracked)

# Desktop release staging (CI produces artifacts; do not commit local builds)
.desktop-release-artifacts/

# Scratch dir for downloaded CI release artifacts (e.g. all-OS desktop-release run
# payloads pulled for refreshing the canonical packages/desktop/releases tree).
.desktop-release-input/

# Browser visual proof output (generated screenshots + reports)
artifacts/

# docs/ssot-ledger is tracked evidence SSOT (defect/improvement/baseline hashes)
packages/desktop/src-tauri/tauri.conf.dev-existing.json
