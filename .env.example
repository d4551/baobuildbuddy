# AI Provider API Keys (optional — can also be set via Settings UI)
# Configure at least one provider for AI features (chat, interview, email response, resume review).
# HuggingFace requires a token even for free tier. Get one at https://huggingface.co/settings/tokens
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
HUGGINGFACE_TOKEN=

# Local model inference (RamaLama / Ollama)
# Local model endpoint — Ollama default is localhost:11434
# Model name is auto-detected from the server if left empty
LOCAL_MODEL_ENDPOINT=http://localhost:11434/v1
LOCAL_MODEL_NAME=

# Server
PORT=3000
# SERVER_PORT overrides PORT when set.
SERVER_PORT=
HOST=0.0.0.0
DB_PATH=~/.bao/bao.db
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# Set to true or 1 to disable API key auth (local dev only)
BAO_DISABLE_AUTH=

# Client (Nuxt)
# API base URL — defaults to API proxy target (http://localhost:3000 in development) when unset
NUXT_PUBLIC_API_BASE=/
NUXT_PUBLIC_WS_BASE=/
# Optional client-side port override when running dev server directly
CLIENT_PORT=
NUXT_CLIENT_PORT=
# Dev proxy target — when empty, Nuxt dev defaults to local server port in development
NUXT_PUBLIC_API_PROXY=
NUXT_PUBLIC_QUERY_STALE_TIME_MS=60000
NUXT_PUBLIC_QUERY_RETRY_COUNT=1
NUXT_PUBLIC_QUERY_REFETCH_ON_FOCUS=true
NUXT_PUBLIC_APP_TITLE=BaoBuildBuddy - AI Career Assistant
NUXT_PUBLIC_APP_DESCRIPTION=AI-powered career assistant for the video game industry
NUXT_PUBLIC_I18N_DEFAULT_LOCALE=en-US
NUXT_PUBLIC_I18N_FALLBACK_LOCALE=en-US
# NOTE: Do NOT set NUXT_PUBLIC_I18N_SUPPORTED_LOCALES here.
# Nuxt runtime config env override replaces the parsed array with a raw string, breaking the i18n plugin.
NUXT_PUBLIC_I18N_LOCALE_COOKIE_KEY=bao-locale

# RPA / Automation (Playwright)
# Increase for large scraper outputs; default is 200
# AUTOMATION_STDIO_BUFFER_LIMIT=2000
