{
  "name": "@bao/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/d4551/baobuildbuddy.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/d4551/baobuildbuddy/issues"
  },
  "homepage": "https://github.com/d4551/baobuildbuddy/tree/main/packages/client",
  "scripts": {
    "dev": "bun --bun run nuxt dev",
    "build": "bun --bun run nuxt build",
    "generate": "bun --bun run nuxt generate",
    "preview": "bun --bun run nuxt preview",
    "prepare:nuxt": "bun --bun run nuxt prepare",
    "prepare:workspace-types": "bun run --cwd ../server build:types && bun run prepare:nuxt",
    "lint:eslint:app": "bun --bun run eslint app.vue error.vue layouts pages middleware plugins",
    "lint:eslint:components": "bun --bun run eslint components",
    "lint:eslint:logic": "bun --bun run eslint composables constants types utils",
    "typecheck": "bun run prepare:workspace-types && bun --bun run nuxt typecheck",
    "test": "bun --bun run vitest run",
    "test:watch": "bun --bun run vitest",
    "lint": "bun run prepare:workspace-types && bun run lint:eslint:app && bun run lint:eslint:components && bun run lint:eslint:logic"
  },
  "dependencies": {
    "@bao/shared": "workspace:*",
    "@elysiajs/eden": "^1.4.8",
    "@nuxt/image": "^2.0.0",
    "@tanstack/vue-query": "^5.92.9",
    "nuxt": "^4.4.2",
    "vue": "^3.5.30",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bao/server": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@nuxt/test-utils": "^4.0.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@vue/test-utils": "^2.4.6",
    "daisyui": "^5.5.19",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.8.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.4",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0",
    "vue-eslint-parser": "^10.4.0"
  }
}
