{
  "name": "@bao/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/d4551/baobuildbuddy.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/d4551/baobuildbuddy/issues"
  },
  "homepage": "https://github.com/d4551/baobuildbuddy/tree/main/packages/client",
  "scripts": {
    "dev": "bun run prepare:workspace-types && bun --bun run nuxt dev",
    "build": "bun --bun run nuxt build",
    "generate": "bun --bun run nuxt generate",
    "preview": "bun --bun run nuxt preview",
    "prepare:nuxt": "bun --bun run nuxt prepare",
    "prepare:workspace-types": "bun run --cwd ../server build:types && bun run prepare:nuxt",
    "typecheck": "bun run prepare:workspace-types && bun --bun ../../node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "bun run prepare:workspace-types && bun --bun run vitest run",
    "test:watch": "bun --bun run vitest",
    "lint": "bun run prepare:workspace-types && bun --bun run eslint ."
  },
  "dependencies": {
    "@bao/shared": "workspace:*",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@elysiajs/eden": "^1.4.9",
    "@nuxt/image": "^2.0.0",
    "@replit/codemirror-minimap": "^0.5.2",
    "@replit/codemirror-vim": "^6.3.0",
    "@tanstack/vue-query": "5.101.4",
    "@tiptap/extension-character-count": "^3.29.1",
    "@tiptap/extension-placeholder": "^3.29.1",
    "@tiptap/pm": "3.29.0",
    "@tiptap/starter-kit": "3.29.0",
    "@tiptap/vue-3": "3.29.0",
    "codemirror": "^6.0.2",
    "nuxt": "^4.5.1",
    "vue": "^3.5.40",
    "vue-i18n": "11.4.7",
    "vue-router": "^5.2.0",
    "y-codemirror.next": "^0.3.5",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@bao/server": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@nuxt/test-utils": "^4.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@vue/test-utils": "^2.4.11",
    "daisyui": "5.7.4",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "globals": "^17.8.0",
    "happy-dom": "^20.11.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  }
}
