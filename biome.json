{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/dist-types",
      "!**/.nuxt",
      "!**/.output",
      "!**/bun.lock",
      "!**/packages/desktop/src-tauri/target",
      "!**/packages/desktop/src-tauri/gen",
      "!**/packages/desktop/src-tauri/icons",
      "!**/.omo",
      "!**/agentiflow",
      "!**/docs/browser-smoke",
      "!**/docs/ssot-ledger/**/*.json",
      "!**/docs/ssot-ledger/**/*.png"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "domains": {
      "vue": "all",
      "drizzle": "all",
      "project": "recommended",
      "test": "recommended",
      "playwright": "all",
      "types": "recommended",
      "react": "none",
      "reactNative": "none",
      "qwik": "none",
      "next": "none",
      "solid": "none",
      "svelte": "none",
      "turborepo": "none"
    },
    "rules": {
      "preset": "recommended",
      "a11y": "error",
      "complexity": {
        "recommended": true,
        "noVoid": "error",
        "noExcessiveCognitiveComplexity": "error",
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 60
          }
        }
      },
      "correctness": {
        "recommended": true,
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "performance": {
        "recommended": true,
        "noBarrelFile": "error",
        "noAwaitInLoops": "error",
        "useTopLevelRegex": "error",
        "noAccumulatingSpread": "error"
      },
      "security": {
        "recommended": true,
        "noSecrets": {
          "level": "error",
          "options": {
            "entropyThreshold": 55
          }
        },
        "noDangerouslySetInnerHtml": "error",
        "noGlobalEval": "error"
      },
      "suspicious": {
        "recommended": true,
        "noConsole": "error",
        "noDebugger": "error",
        "noExplicitAny": "error",
        "noSkippedTests": "error",
        "noFocusedTests": "error",
        "noExportsInTest": "error",
        "noAlert": "error",
        "noDocumentCookie": "error"
      },
      "style": {
        "recommended": true,
        "noNonNullAssertion": "error",
        "useConst": "error",
        "useTemplate": "error",
        "useExportType": "error",
        "useImportType": "error",
        "useNodejsImportProtocol": "error",
        "useNumberNamespace": "error",
        "useShorthandFunctionType": "error",
        "noUselessElse": "error",
        "useDefaultParameterLast": "error",
        "useExponentiationOperator": "error",
        "useAsConstAssertion": "error",
        "useEnumInitializers": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useAwaitThenable": "error",
        "noVueImportCompilerMacros": "error",
        "noVueRefAsOperand": "info",
        "useVueNextTickPromise": "error",
        "noDrizzleDeleteWithoutWhere": "error",
        "noDrizzleUpdateWithoutWhere": "error",
        "noPlaywrightElementHandle": "error",
        "noPlaywrightEval": "error",
        "noPlaywrightForceOption": "error",
        "noPlaywrightMissingAwait": "error",
        "noPlaywrightNetworkidle": "error",
        "noPlaywrightPagePause": "error",
        "noPlaywrightUselessAwait": "error",
        "noPlaywrightWaitForTimeout": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.{ts,js,mjs,cjs}"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "error",
            "noUnusedVariables": "error",
            "noUnusedFunctionParameters": "error"
          }
        }
      }
    },
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "info",
            "noUnusedVariables": "info",
            "noUnusedFunctionParameters": "info"
          },
          "style": {
            "useVueMultiWordComponentNames": "error",
            "useVueDefineMacrosOrder": "error"
          },
          "nursery": {
            "noVueRefAsOperand": "info",
            "noVueImportCompilerMacros": "error",
            "useVueNextTickPromise": "error"
          }
        }
      }
    },
    {
      "includes": ["**/pages/**/*.vue", "**/layouts/**/*.vue", "**/app.vue", "**/error.vue"],
      "linter": {
        "rules": {
          "style": {
            "useVueMultiWordComponentNames": "info"
          }
        }
      }
    }
  ]
}
