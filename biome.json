{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/dist-types",
      "!**/.nuxt",
      "!**/.output",
      "!**/bun.lock",
      "!**/packages/desktop/src-tauri/target",
      "!**/packages/desktop/src-tauri/gen",
      "!**/packages/desktop/src-tauri/icons",
      "!**/.omo"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noVoid": "error"
      },
      "performance": {
        "noBarrelFile": "error",
        "noAwaitInLoops": "error",
        "useTopLevelRegex": "error"
      },
      "security": "error",
      "suspicious": {
        "noConsole": "error",
        "noDebugger": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.vue"],
      "linter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/packages/client/locales/**/*.ts"],
      "linter": {
        "rules": {
          "security": {
            "noSecrets": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/packages/client/composables/useFocusTrap.ts",
        "**/packages/client/constants/dashboard.ts"
      ],
      "linter": {
        "rules": {
          "security": {
            "noSecrets": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**/*.test.ts"],
      "linter": {
        "rules": {
          "security": {
            "noSecrets": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/client/constants/layout.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": [
        "scripts/browser-record-product-demo.ts",
        "scripts/browser-record-desktop-capabilities.ts",
        "scripts/browser-record-visual-proof.ts",
        "scripts/browser-interaction-burndown.ts",
        "scripts/browser-proof-ollama-live.ts",
        "scripts/browser-proof-pdf-live.ts",
        "scripts/browser-proof-rpa-live.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off"
          }
        }
      }
    }
  ]
}
