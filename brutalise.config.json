{
  "$schema": "brutalise.config.json",
  "ruleOverrides": [
    {
      "rule": "UI003",
      "files": [
        "packages/shared/src/constants/branding.ts",
        "packages/client/assets/css/resume-preview.generated.css",
        "packages/client/assets/css/base.css"
      ],
      "severity": "off",
      "reason": "SSOT token definition files — oklch/color literals are the canonical source"
    },
    {
      "rule": "UI008",
      "files": ["packages/client/constants/ui-layout.ts"],
      "severity": "off",
      "reason": "SSOT layout grid definitions — grid class strings are the canonical source"
    },
    {
      "rule": "UI007",
      "files": ["packages/client/constants/layout-chrome.ts"],
      "severity": "off",
      "reason": "SSOT media query definitions — breakpoint literals are the canonical source"
    },
    {
      "rule": "UI018",
      "files": ["packages/client/assets/css/base.css"],
      "severity": "off",
      "reason": "CSS custom property definitions — font-family var() declarations are token setup"
    },
    {
      "rule": "UI013",
      "files": [
        "packages/client/assets/css/a11y-preferences.css",
        "packages/client/assets/css/shell.css"
      ],
      "severity": "off",
      "reason": "Accessibility preference overrides — backdrop-filter:none required for reduced-motion a11y"
    },
    {
      "rule": "HB006",
      "files": ["packages/server/src/test-setup.ts", "packages/server/src/test-utils.ts"],
      "severity": "off",
      "reason": "Test infrastructure — process.env mutation required for test isolation"
    },
    {
      "rule": "HB012",
      "files": ["packages/server/src/test-setup.ts"],
      "severity": "off",
      "reason": "Test infrastructure — Bun.env mutation required for test isolation"
    },
    {
      "rule": "DRY004",
      "files": [
        "packages/scraper/src/data/studios.generated.ts",
        "packages/server/src/db/seed/studios.ts",
        "**/*.test.ts",
        "scripts/validate-ui-i18n.ts",
        "scripts/capture-page-proof.ts",
        "scripts/validate-ascii-geometry.ts"
      ],
      "severity": "warning",
      "reason": "Generated/seed data and test files — line count inherent or demoted"
    },
    {
      "rule": "HB004",
      "files": ["scripts/patch-upstream-dts-nocheck.ts"],
      "severity": "off",
      "reason": "Script purpose is patching upstream .d.ts — ts-nocheck reference is the function"
    },
    {
      "rule": "TS001",
      "files": [
        "packages/shared/src/utils/automation-run-honesty.ts",
        "**/*normalizer*.ts",
        "**/*validator*.ts",
        "**/*honesty*.ts",
        "**/*type-guards*.ts",
        "**/*value-parsers*.ts",
        "**/*config-normalizers*.ts"
      ],
      "severity": "off",
      "reason": "Boundary normalizers/validators — unknown is correct for untrusted DB/JSON input"
    },
    {
      "rule": "DRY002",
      "files": ["**/*.test.ts"],
      "severity": "warning",
      "reason": "Test fixtures repeat literals for readability"
    },
    {
      "rule": "HB001",
      "files": ["**/*.test.ts"],
      "severity": "warning",
      "reason": "Test infrastructure try/catch for setup/teardown"
    },
    {
      "rule": "DRY001",
      "files": [
        "packages/shared/src/schemas/settings.schema.ts",
        "packages/shared/src/schemas/settings-brand.schema.ts"
      ],
      "severity": "off",
      "reason": "Canonical barrel — settings.schema.ts is SSOT entry, settings-brand.schema.ts is definition"
    },
    {
      "rule": "TS002",
      "files": [
        "packages/shared/src/constants/ai-provider.ts",
        "packages/shared/src/schemas/settings.schema.ts",
        "packages/shared/src/constants/automation.ts"
      ],
      "severity": "off",
      "reason": "Zod enum from const array requires tuple assertion — canonical schema pattern"
    },
    {
      "rule": "TS003",
      "files": ["packages/server/src/services/jobs/providers/provider-interface.ts"],
      "severity": "off",
      "reason": "RawJob provider boundary for heterogeneous external API responses"
    },
    {
      "rule": "UI001",
      "files": [
        "packages/client/pages/interview/index.vue",
        "packages/client/components/interview/InterviewConfigModal.vue"
      ],
      "severity": "off",
      "reason": "Vue @update:conversation-style event binding — false positive from style= substring"
    },
    {
      "rule": "DRY005",
      "files": ["**/*.test.ts", "scripts/**/*.ts"],
      "severity": "warning",
      "reason": "Test files and build/proof scripts — function length demoted to warning"
    }
  ]
}
